{
    "name": "janole/laravel-dockerize",
    "description": "A very simple tool to containerize your Laravel app",
    "keywords": [
        "laravel",
        "docker",
        "dockerize",
        "containerize"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jan Ole Suhr",
            "email": "ole@janole.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "vlucas/phpdotenv": "^5.6",
        "ext-json": "*"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "janole\\Laravel\\Dockerize\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "janole\\Laravel\\Dockerize\\PackageServiceProvider"
            ]
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59"
    }
}
